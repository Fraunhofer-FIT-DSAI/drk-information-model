    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://schema.org/genre -->


    <owl:ObjectProperty rdf:about="https://schema.org/genre"/>
    


    <!-- https://w3id.org/drk/ontology/accessibilityDescription -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/accessibilityDescription">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/PlaceAccessibilityFeature"/>
        <rdfs:range rdf:resource="https://schema.org/Text"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/accessibleWith -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/accessibleWith">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/PlaceAccessibilityFeature"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that is used to specify with what disability profile can a person access the given place. For example, the place owner or an external agency might specify that the given place can be comfortably accessed by a person who uses a wheelchair, or who has a visual impairment.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Accessible With Personal (Disability) Profile Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/animalPolicy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/animalPolicy">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/PlaceAccessibilityFeature"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/AnimalPolicy"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that is used to describe the policies of a place concerning bringing animals along.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Animal Policy Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/associatedDataService -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/associatedDataService">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:comment xml:lang="en">A property that links an organization to an associated data service through which its data can be accessed or provided.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Associated Data Service</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/character -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/character">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/CharacterPerformanceRole"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/Character"/>
        <rdfs:comment xml:lang="en">A property that links a character performance role to the character represented or performed in that role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/characterPerformanceRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/characterPerformanceRole">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/CharacterPerformanceRole"/>
        <rdfs:comment xml:lang="en">A property that is used to specify and link the details of characters in a creative work such as a play to the respective performers and the roles played by them.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character Performance Role Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/characterRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/characterRole">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalProduction"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/CharacterPerformanceRole"/>
        <rdfs:comment xml:lang="en">A property that is used to specify the characters and the roles played by them in a theatrical play. For example, the role of &apos;Romeo&apos; in &apos;Romeo and Juliet&apos; by William Shakespeare is a character role.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character Role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/characterType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/characterType">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Character"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A property that specifies the type of a character in a creative work or during an event. Examples of character types include person, animal, organization, puppet, robot, inanimate object, imaginary entity, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/containsTheaterShowtimesRecord -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/containsTheaterShowtimesRecord">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheaterShowtimesDataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment xml:lang="en">A property that links a theater showtimes dataset to a theater showtimes record, for example a named graph or other RDF resource representing a record in the dataset.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Contains Theater Showtimes Record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/creatorRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/creatorRole">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalProduction"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/ProductionRole"/>
        <rdfs:comment xml:lang="en">A property that is used to specify the names of creator roles involved in a theatrical production that are, for instance, not characters in the play. For example, William Shakespeare performed the roles of playwright and creator in the production of his play &apos;Romeo and Juliet&apos;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Creator Role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/eventRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/eventRole">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Event"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/ProductionRole"/>
        <rdfs:comment xml:lang="en">A property that is used to link the production roles in an event that features theatrical work such as a play to its performers. Event roles are (mostly off-stage) production roles that are performed during the preparation or performance of an Event. Examples include director, costume designer, stage manager, set/stage designer, lighting designer, sound designer, sound engineer, technical director, makeup artist, choreographer, understudy, usher, production manager, producer, funder, sponsor, front of house manager, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Event Role Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/eventType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/eventType">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A property that specifies theatrical event types such as Premiere, Last Performance, Guest Performance, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Event Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/hasAccessibilityFeature -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/hasAccessibilityFeature">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Place"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/PlaceAccessibilityFeature"/>
        <rdfs:comment xml:lang="en">A property that is used to describe the physical (and sometimes human-rated) accessibility of a physical place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Has Accessibility Feature Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/hasTheatricalEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/hasTheatricalEvent">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheaterOrganization"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/TheatricalEvent"/>
        <rdfs:comment xml:lang="en">A property that links a theater organization to a theatrical event associated with that organization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Has Theatrical Event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/hasTheatricalProduction -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/hasTheatricalProduction">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheaterOrganization"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/TheatricalProduction"/>
        <rdfs:comment xml:lang="en">A property that links a theater organization to a theatrical production associated with that organization.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Has Theatrical Production</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/navigationMapURL -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/navigationMapURL">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Place"/>
        <rdfs:range rdf:resource="https://schema.org/URL"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/performer -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/performer">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Role"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/Performer"/>
        <rdfs:comment xml:lang="en">A property that is used to specify the performer of a role in a creative work or event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Performer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/performerType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/performerType">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Performer"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A property that specifies the type of performer that performs a role in a creative work or event. Examples of performer types include persons, animals, organizations, puppets, robots, inanimate objects, or even computer-generated imagery (CGI).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Performer Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/productionType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/productionType">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalProduction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A property that specifies the production type of a creative work, such as &apos;World Premiere&apos;, &apos;Language Premiere&apos;, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Production Type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/subtitleLanguage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/subtitleLanguage">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalEvent"/>
        <rdfs:range rdf:resource="https://schema.org/Language"/>
        <rdfs:comment xml:lang="en">A property that specifies the languages in which subtitles or captions are available during a Theatrical Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Subtitle Language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/theatricalGenre -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/theatricalGenre">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/genre"/>
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/TheatricalProduction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A property that specifies the theatrical genre of a theatrical production.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Theatrical Genre</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/drk/ontology/wheelchairPlaces -->


    <owl:ObjectProperty rdf:about="https://w3id.org/drk/ontology/wheelchairPlaces">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/PlaceAccessibilityFeature"/>
        <rdfs:range rdf:resource="https://w3id.org/drk/ontology/WheelchairPlaces"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that is used to describe the presence of reserved spots for wheelchairs at a place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Wheelchair Places Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://schema.org/URL -->


    <owl:DatatypeProperty rdf:about="https://schema.org/URL"/>
    


    <!-- https://w3id.org/drk/ontology/accessibilityDescription -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/accessibilityDescription"/>
    


    <!-- https://w3id.org/drk/ontology/allowsAssistanceDogs -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/allowsAssistanceDogs">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/drk/ontology/allowsDogs"/>
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/drk/ontology/allowsServiceAnimals"/>
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/AnimalPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that describes if the place allows visitors to bring assistance/service dogs. Assistance dogs, also referred to as a service dogs, are a specific type of service animals that receive specialized training to aid an individual with a disability in navigating everyday life (source: https://en.wikipedia.org/wiki/Assistance_dog).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Allows Assistance/Service Dogs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/allowsDogs -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/allowsDogs">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/AnimalPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that describes if the place allows visitors to bring dogs in general.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Allows Dogs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/allowsGuideDogs -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/allowsGuideDogs">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/drk/ontology/allowsAssistanceDogs"/>
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/AnimalPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that describes if the place allows visitors to bring guide dogs. Guide dogs are a specialized type of assistance dogs, trained to lead individuals who are blind or visually impaired around obstacles (source: https://en.wikipedia.org/wiki/Guide_dog).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Allows Guide Dogs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/allowsServiceAnimals -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/allowsServiceAnimals">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/AnimalPolicy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that describes if the place allows visitors to bring service animals along. A Service Animal is an animal that has been trained to assist a disabled person (source: https://en.wikipedia.org/wiki/Service_animal). While dogs are the most common service animals, other animals (like miniature horses, ferrets, parrots, and monkeys) may also serve in this role, depending upon regional regulations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Allows Service Animals</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/hasSpaceForAssistant -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/hasSpaceForAssistant">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/WheelchairPlaces"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that specifies whether the place has additional space for a wheelchair assistant.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Has Space For Wheelchair Assistant Property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/intermissionCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/intermissionCount">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="en">A property that specifies the number of intermissions or breaks during an Event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Intermission Count</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/navigationMapURL -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/navigationMapURL">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/URL"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/wheelchairPlacesCount -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/wheelchairPlacesCount">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/WheelchairPlaces"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that specifies the number of designated places for wheelchairs, for example, in a theater place or a cinema hall.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Wheelchair Places Count Property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/drk/ontology/wheelchairUserCapacity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/drk/ontology/wheelchairUserCapacity">
        <rdfs:domain rdf:resource="https://w3id.org/drk/ontology/WheelchairPlaces"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A property that specifies the number of people using a wheelchair that can be accommodated at the same time. This property should be used when there is no designated space for wheelchair users, but the number is known.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Wheelchair User Capacity Property</rdfs:label>
    </owl:DatatypeProperty>
    


