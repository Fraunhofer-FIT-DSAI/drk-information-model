    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#Muteness -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#Muteness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A term that describes the profile of a person who is unable to speak.</rdfs:comment>
        <rdfs:label xml:lang="en">Muteness</rdfs:label>
        <skos:closeMatch rdf:resource="https://dbpedia.org/resource/Muteness"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q671776"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#VisualImpairment -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#VisualImpairment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
