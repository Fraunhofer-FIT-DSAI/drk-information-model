    <!-- http://w3id.org/drk/vocabs/theatrical-event-types#LastPerformance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-event-types#LastPerformance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The final performance of a theatrical production at a specific venue.</rdfs:comment>
        <rdfs:label xml:lang="de">Dernière</rdfs:label>
        <rdfs:label xml:lang="en">Last Performance</rdfs:label>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q1200301"/>
