    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#HearingImpairment -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#HearingImpairment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A term that describes the profile of a person who has a hearing impairment.</rdfs:comment>
        <rdfs:label xml:lang="en">Hearing Impairment</rdfs:label>
        <skos:closeMatch rdf:resource="https://dbpedia.org/resource/Hearing_impairment"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q16035842"/>
