        <rdfs:comment xml:lang="en">A term that describes the profile of a person who has a learning impairment.</rdfs:comment>
        <rdfs:label xml:lang="en">Learning Impairment</rdfs:label>
        <skos:closeMatch rdf:resource="https://dbpedia.org/resource/Learning_impairment"/>
