    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#MobilityImpairment -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#MobilityImpairment">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A term that describes the profile of a person who has a mobility impairment.</rdfs:comment>
        <rdfs:label xml:lang="en">Mobility Impairment</rdfs:label>
        <skos:closeMatch rdf:resource="https://dbpedia.org/resource/Mobility_impairment"/>
