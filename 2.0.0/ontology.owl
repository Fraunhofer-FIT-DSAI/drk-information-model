    <!-- http://w3id.org/drk/vocabs/theatrical-event-types# -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-event-types#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:description xml:lang="en">A controlled vocabulary for listing and describing theatrical event types.</terms:description>
        <terms:hasVersion>0.0.1</terms:hasVersion>
        <terms:title xml:lang="en">Theatrical Event Types Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>tevent</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/drk/vocabs/theatrical-event-types#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A controlled vocabulary for listing and describing theatrical event types.</rdfs:comment>
        <rdfs:label xml:lang="en">Theatrical Event Types Vocabulary</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-event-types#GuestPerformance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-event-types#GuestPerformance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A performance by a theater company or artist presented at a venue where they are not the resident performers.</rdfs:comment>
        <rdfs:label xml:lang="de">Gastspiel</rdfs:label>
        <rdfs:label xml:lang="en">Guest Performance</rdfs:label>
