    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#LearningImpairment -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#LearningImpairment">
