    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-event-types#Premiere -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-event-types#Premiere">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The first public performance of a theatrical creative work, such as a play, dance, or musical composition.</rdfs:comment>
        <rdfs:label xml:lang="de">Premiere</rdfs:label>
        <rdfs:label xml:lang="en">Première</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Premiere"/>
        <skos:altLabel xml:lang="en">Premiere</skos:altLabel>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q204854"/>
