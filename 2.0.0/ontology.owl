        <skos:altLabel xml:lang="en">Live Audio Drama</skos:altLabel>
        <skos:altLabel xml:lang="en">Live Audio Play</skos:altLabel>
        <skos:altLabel xml:lang="en">Live Radio Drama</skos:altLabel>
        <skos:altLabel xml:lang="de">Livehörspiel</skos:altLabel>
        <skos:closeMatch rdf:resource="http://d-nb.info/gnd/4025435-5"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#MusicTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#MusicTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre that encompasses both opera and other forms of musical performance on stage.</rdfs:comment>
        <rdfs:label xml:lang="en">Music Theater</rdfs:label>
        <rdfs:label xml:lang="de">Musiktheater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Music_theatre"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4040874-7"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Musical -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Musical">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of theatrical performance that combines songs, spoken dialogue, acting, and dance.</rdfs:comment>
        <rdfs:label xml:lang="de">Musical</rdfs:label>
        <rdfs:label xml:lang="en">Musical</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Musical_theatre"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4040801-2"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#ObjectTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#ObjectTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of theater where everyday objects are used as primary elements in performance.</rdfs:comment>
        <rdfs:label xml:lang="en">Object Theater</rdfs:label>
        <rdfs:label xml:lang="de">Objekttheater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://wepa.unima.org/en/object-theatre"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Opera -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Opera">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of music theater in which a dramatic work is performed by singers and musicians.</rdfs:comment>
        <rdfs:label xml:lang="de">Oper</rdfs:label>
        <rdfs:label xml:lang="en">Opera</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Opera"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4043582-9"/>
        <skos:exactMatch rdf:resource="http://dbpedia.org/ontology/Opera"/>
        <skos:exactMatch rdf:resource="http://www.kanzaki.com/ns/music#Opera"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Operetta -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Operetta">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of light opera, with spoken dialogue, songs, and dances.</rdfs:comment>
        <rdfs:label xml:lang="en">Operetta</rdfs:label>
        <rdfs:label xml:lang="de">Operette</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Operetta"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4043602-0"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#OutdoorTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#OutdoorTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A form of theater that is performed in outdoor, public spaces.</rdfs:comment>
        <rdfs:label xml:lang="en">Outdoor Theater</rdfs:label>
        <rdfs:label xml:lang="de">Theater im öffentlichen Raum</rdfs:label>
        <skos:altLabel xml:lang="en">Open-air Theatre</skos:altLabel>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q11183017"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Performance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Performance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre that emphasizes the act of performing, often breaking the traditional boundaries of theater.</rdfs:comment>
        <rdfs:label xml:lang="de">Performance</rdfs:label>
        <rdfs:label xml:lang="en">Performance</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Performance_art"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4173750-7"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#PhysicalTheatre -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#PhysicalTheatre">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre that focuses on physical movement and body language as the primary means of storytelling.</rdfs:comment>
        <rdfs:label xml:lang="en">Physical Theater</rdfs:label>
        <rdfs:label xml:lang="de">Physical Theatre</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Physical_theatre"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#PuppetTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#PuppetTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A form of theater where puppets, rather than live actors, are the main performers.</rdfs:comment>
        <rdfs:label xml:lang="de">Puppentheater</rdfs:label>
        <rdfs:label xml:lang="en">Puppet Theater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Puppetry"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Reading -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Reading">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A public event where literature is read aloud to an audience.</rdfs:comment>
        <rdfs:label xml:lang="de">Lesung</rdfs:label>
        <rdfs:label xml:lang="en">Reading</rdfs:label>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#SpokenTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#SpokenTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A form of theater in which spoken language is the primary means of communication.</rdfs:comment>
        <rdfs:label xml:lang="en">Spoken Theater</rdfs:label>
        <rdfs:label xml:lang="de">Sprechtheater</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://ladydayonbroadway.com/spoken-theater-an-overview"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4182552-4"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q39892385"/>
