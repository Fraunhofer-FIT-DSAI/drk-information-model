        <rdfs:comment xml:lang="en">A term that describes the profile of a person who needs a guide dog.</rdfs:comment>
        <rdfs:label xml:lang="en">Guide Dog</rdfs:label>
        <skos:closeMatch rdf:resource="https://dbpedia.org/resource/Guide_dog"/>
