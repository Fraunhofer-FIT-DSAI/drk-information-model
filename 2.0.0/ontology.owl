        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:description xml:lang="en">A controlled vocabulary for listing and describing theatrical genres.</terms:description>
        <terms:hasVersion>0.0.1</terms:hasVersion>
        <terms:title xml:lang="en">Theatrical Genres Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>tgenres</vann:preferredNamespacePrefix>
