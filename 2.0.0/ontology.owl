    <!-- https://schema.org/URL -->


    <owl:Class rdf:about="https://schema.org/URL"/>
    


    <!-- https://w3id.org/drk/ontology/AnimalPolicy -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/AnimalPolicy">
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A class that describes the policies of a place concerning bringing animals along.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Animal Policy Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Character -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Character">
        <rdfs:comment xml:lang="en">A class that represents a character in a creative work such as a Play.
    Examples of characters include:
    Romeo (from Romeo and Juliet by William Shakespeare; character type: Person),
    Alexander Hamilton (from Hamilton musical by Lin-Manuel Miranda; character type: Person),
    Simba (from The Lion King; character type: Animal),
    Kermit the Frog (from The Muppet Show; character type: Puppet),
    WALL-E (from Pixar&apos;s WALL-E movie; character type: Robot),
    Puck (from A Midsummer Night&apos;s Dream by William Shakespeare; character type: Imaginary Entity/Fairy),
    the flying Magic Carpet (from Aladdin; character type: Inanimate Object), etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/CharacterPerformanceRole -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/CharacterPerformanceRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/Role"/>
        <rdfs:comment xml:lang="en">A class that links a character role to its performer.
    Characters can be from a creative work such as a Play.
    Examples of characters include Romeo (from Romeo and Juliet by William Shakespeare; characterType: Person), Alexander Hamilton (from Hamilton musical by Lin-Manuel Miranda; characterType: Person), Simba (from The Lion King; characterType: Animal), Kermit the Frog (from The Muppet Show; characterType: Puppet), WALL-E (from Pixar&apos;s WALL-E movie; characterType: Robot), Puck (from A Midsummer Night&apos;s Dream by William Shakespeare; characterType: Imaginary Entity (Fairy)), the flying Magic Carpet (from Aladdin; characterType: Inanimate Object), etc.
    Performers can include persons, animals, organizations, puppets, robots, inanimate objects, or even computer-generated imagery (CGI) in a creative work or during an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Character Performance Role Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/CulturalOrganization -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/CulturalOrganization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/Organization"/>
        <rdfs:comment xml:lang="en">A class for organizations in the culture domain, such as theaters, museums, libraries, orchestras, and cultural associations.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Cultural Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/DataService -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/DataService">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Service"/>
        <rdfs:comment xml:lang="en">A class for data services that provide access to datasets or records.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Data Service</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Event -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Event">
        <rdfs:subClassOf rdf:resource="https://schema.org/Event"/>
        <rdfs:comment xml:lang="en">A class that describes a thing happening at a particular location and at a particular time such as a theatrical play performance, movie screening, concert, or festival.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Organization -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Organization">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">A class for describing organizations. It extends schema:Organization and can be associated with data services and other organizational metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Performer -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Performer">
        <rdfs:comment xml:lang="en">A class that specifies the performer of a role in a creative work or event. Performers can include persons, animals, organizations, puppets, robots, inanimate objects, or even computer-generated imagery (CGI).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Performer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/PerformingArtsTheater -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/PerformingArtsTheater">
        <rdfs:subClassOf rdf:resource="https://schema.org/PerformingArtsTheater"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/Place"/>
        <rdfs:comment xml:lang="en">A place such as a building, a group of buildings, or an event site that is designated for organizing theatrical events such as plays.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Performing Arts Theater</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Place -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Place">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment xml:lang="en">A class that describes a physical place or location. The drk:Place class extends schema:Place to describe the accessibility features available at the place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Place</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/PlaceAccessibilityFeature -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/PlaceAccessibilityFeature">
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A class that describes the physical (and sometimes human-rated) accessibility of a physical place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Place Accessibility Feature Class</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/ProductionRole -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/ProductionRole">
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/Role"/>
        <rdfs:comment xml:lang="en">A class that links a production role to its performer.
    Production roles can, in general, include creator roles, non-character roles, offstage or behind-the-scenes roles.
    Examples of production roles include creator, writer, playwright, costume designer, stage designer, choreographer, makeup artist, understudy, usher, funder, sponsor, etc.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Production Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/Role -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/Role">
        <rdfs:subClassOf rdf:resource="https://schema.org/Role"/>
        <rdfs:comment xml:lang="en">A class that links a role to its performer.
    Roles can, in general, be of various types such as character roles, production roles, event roles, onstage roles, offstage or behind-the-scenes roles.
    Examples of role names include creator, writer, playwright, actor, protagonist, puppeteer, singer, cameo, costume designer, stage designer, choreographer, makeup artist, understudy, funder, sponsor, etc.
    Performers can include persons, animals, organizations, puppets, robots, inanimate objects, or even computer-generated imagery (CGI) in a creative work or during an event.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/TheaterOrganization -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/TheaterOrganization">
        <rdfs:subClassOf rdf:resource="https://schema.org/TheaterGroup"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/CulturalOrganization"/>
        <rdfs:comment xml:lang="en">A class for theater organizations, such as theater groups, companies, or associations, that provide information about theatrical productions and events.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Theater Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/TheaterShowtimesDataset -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/TheaterShowtimesDataset">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Collection"/>
        <rdfs:comment xml:lang="en">A class for datasets containing theater showtimes data, including records about theater organizations, productions, events, venues, offers, and related metadata.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Theater Showtimes Dataset</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/TheatricalEvent -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/TheatricalEvent">
        <rdfs:subClassOf rdf:resource="https://schema.org/TheaterEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/drk/ontology/Event"/>
        <rdfs:comment xml:lang="en">A class that describes the presentation of a theatrical creative work such as a play.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Theatrical Event or or Theater Event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/TheatricalProduction -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/TheatricalProduction">
        <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:comment xml:lang="en">A class that includes all stages of Theatrical Production (including Play Production) from writing, planning, casting, and staging to rehearsal, but excludes the final presentation or performance, which is modeled as an Event using the drk:TheatricalEvent class.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Theatrical Production</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/drk/ontology/WheelchairPlaces -->


    <owl:Class rdf:about="https://w3id.org/drk/ontology/WheelchairPlaces">
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
        <rdfs:comment xml:lang="en">A class that describes the presence of reserved spots for wheelchairs at a place.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/drk/ontology/"/>
        <rdfs:label xml:lang="en">Wheelchair Places</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://w3id.org/drk/vocabs/character-types# -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:description xml:lang="en">A controlled vocabulary for listing and describing various types of characters in creative works such as plays or movies.</terms:description>
        <terms:hasVersion>0.0.1</terms:hasVersion>
        <terms:title xml:lang="en">Character Types Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>tchar</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/drk/vocabs/character-types#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A controlled vocabulary for listing and describing various types of characters in creative works such as plays or movies.</rdfs:comment>
        <rdfs:label xml:lang="en">Character Types Vocabulary</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#Animal -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#Animal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A non-human animal character in a creative work such as a play. For example, &apos;Simba&apos; from The Lion King.</rdfs:comment>
        <rdfs:label xml:lang="en">Animal Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Animal"/>
        <skos:closeMatch rdf:resource="https://dbpedia.org/ontology/Animal"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q729"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#ImaginaryEntity -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#ImaginaryEntity">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A fictional or mythical being, legendary creature, or a fantasy entity character in a creative work such as a play. For example, the fairy &apos;Puck&apos; from A Midsummer Night&apos;s Dream.</rdfs:comment>
        <rdfs:label xml:lang="en">Imaginary Entity Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Fairy"/>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Legendary_creature"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
        <skos:narrowMatch rdf:resource="https://www.wikidata.org/entity/Q8028"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#InanimateObject -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#InanimateObject">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A physical non-living thing character in a creative work such as a play. For example, the flying &apos;Magic Carpet&apos; from Aladdin.</rdfs:comment>
        <rdfs:label xml:lang="en">Inanimate Object Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Physical_object"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q61964280"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#Person -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#Person">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A real or fictional human individual who is a character in a creative work such as a play. For example, &apos;Romeo&apos; from Romeo and Juliet by William Shakespeare.</rdfs:comment>
        <rdfs:label xml:lang="en">Person Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Person"/>
        <skos:altLabel xml:lang="en">Human Character</skos:altLabel>
        <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <skos:closeMatch rdf:resource="https://schema.org/Person"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q5"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#Puppet -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#Puppet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A figure or model character in a creative work such as a play that is meant to be manipulated by a puppeteer in performances. For example, &apos;Kermit the Frog&apos; from The Muppet Show.</rdfs:comment>
        <rdfs:label xml:lang="en">Puppet Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Puppet"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q1913135"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/character-types#Robot -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/character-types#Robot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A machine character that is meant to perform physical activities in a creative work such as a play. For example, the &apos;WALL-E&apos; robot from Pixar&apos;s WALL-E movie.</rdfs:comment>
        <rdfs:label xml:lang="en">Robot Character</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Robot"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q11012"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/character-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types# -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:description xml:lang="en">A controlled vocabulary for listing and describing various types of performers in a creative work such as a play or a movie.</terms:description>
        <terms:hasVersion>0.0.1</terms:hasVersion>
        <terms:title xml:lang="en">Performer Types Vocabulary</terms:title>
        <vann:preferredNamespacePrefix xml:lang="en">tperf</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/drk/vocabs/performer-types#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A controlled vocabulary for listing and describing various types of performers in a creative work such as a play or a movie.</rdfs:comment>
        <rdfs:label xml:lang="en">Performer Types Vocabulary</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Animal -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Animal">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A non-human animal that performs a role in the production or performance of a creative work such as a play or a movie. For example, &apos;Crystal the Monkey&apos; played the role of &apos;Dexter&apos; in the 2006 movie &apos;Night at the Museum&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Animal Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Animal"/>
        <skos:closeMatch rdf:resource="https://dbpedia.org/ontology/Animal"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q729"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#CGI -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#CGI">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">CGI used to perform a character role in a creative work such as a play or a movie. Examples include &apos;The T-rex&apos; from the 1993 movie &apos;Jurassic Park&apos;, &apos;Gollum&apos; from &apos;The Lord of the Rings Trilogy&apos;, and &apos;WALL-E&apos; from Pixar&apos;s 2008 movie &apos;WALL-E&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Computer-Generated Imagery (CGI) Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Computer-generated_imagery"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q6002306"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#InanimateObject -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#InanimateObject">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A physical non-living thing that performs a role in a creative work such as a play or a movie. Examples include Captain America&apos;s Shield from Marvel Cinematic Universe, &apos;Wilson the Volleyball&apos; from the 2000 movie &apos;Cast Away&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Inanimate Object Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Physical_object"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q61964280"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Organization -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Organization">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A company or organization performing a role in the production of a creative work, e.g., by funding or sponsoring it.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Organization"/>
        <skos:closeMatch rdf:resource="https://dbpedia.org/ontology/Organization"/>
        <skos:closeMatch rdf:resource="https://schema.org/Organization"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q43229"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Person -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Person">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A human individual that performs a role in the production or performance of a creative work such as a play or a movie. For example, William Shakespeare performed the role of author in the production of his play &apos;Romeo and Juliet&apos;; Christian Bale performed the roles of &apos;Actor&apos; and &apos;Protagonist&apos; while playing the characters of &apos;Batman&apos; and &apos;Bruce Wayne&apos; in Christopher Nolan&apos;s 2008 movie &apos;The Dark Knight&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Person Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Person"/>
        <skos:altLabel xml:lang="en">Human Performer</skos:altLabel>
        <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <skos:closeMatch rdf:resource="https://dbpedia.org/ontology/Person"/>
        <skos:closeMatch rdf:resource="https://schema.org/Person"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q5"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Puppet -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Puppet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">An inanimate figure or model manipulated by a puppeteer that performs a role in a creative work such as a play or a movie. For example, the kermit puppet artifact that featured as &apos;Kermit the Frog&apos; in &apos;The Muppet Show&apos;. Jim Henson&apos;s original Kermit is currently on display at the National Museum of American History.</rdfs:comment>
        <rdfs:label xml:lang="en">Puppet Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Puppet"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q1913135"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Puppeteer -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Puppeteer">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A person who manipulates a puppet in the performance of a creative work such as a play or a movie. For example, Jim Henson as the puppeteer for &apos;Kermit the Frog&apos; in &apos;The Muppet Movie&apos; (1979).</rdfs:comment>
        <rdfs:label xml:lang="en">Puppeteer Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Puppeteer"/>
        <skos:closeMatch rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <skos:closeMatch rdf:resource="https://dbpedia.org/ontology/Person"/>
        <skos:closeMatch rdf:resource="https://schema.org/Person"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q5"/>
        <skos:exactMatch rdf:resource="https://www.wikidata.org/entity/Q2629392"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/performer-types#Robot -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/performer-types#Robot">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A machine, especially one that can be programmed, that performs a role involving complex physical activities in a creative work such as a play or a movie. For example, &apos;Robby the Robot&apos; from the 1956 film Forbidden Planet, which has been showcased at the Smithsonian National Museum of American History; &apos;T-800&apos; from the Terminator film series, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Robot Performer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Robot"/>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q11012"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/performer-types#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility# -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#">
        <rdf:type rdf:resource="http://purl.org/vocommons/voaf#Vocabulary"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <terms:description xml:lang="en">A controlled vocabulary for identifying and describing personal profiles from a disability perspective, aimed at facilitating accessibility.</terms:description>
        <terms:hasVersion>0.0.1</terms:hasVersion>
        <terms:source rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/#personalprofile"/>
        <terms:title xml:lang="en">Personal Profile for Accessibility Vocabulary</terms:title>
        <vann:preferredNamespacePrefix>ppfa</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://w3id.org/drk/vocabs/personal-profile-for-accessibility#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">A controlled vocabulary for identifying and describing personal profiles from a disability perspective, aimed at facilitating accessibility.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal Profile for Accessibility Vocabulary</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://sozialhelden.github.io/a11yjson/describing-objects/0-model/"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#Blindness -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#Blindness">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A term that describes the profile of a person who is blind.</rdfs:comment>
        <rdfs:label xml:lang="en">Blindness</rdfs:label>
        <skos:closeMatch rdf:resource="https://www.wikidata.org/entity/Q10874"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/personal-profile-for-accessibility#GuideDog -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/personal-profile-for-accessibility#GuideDog">
