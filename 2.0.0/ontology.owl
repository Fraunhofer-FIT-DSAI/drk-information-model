    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Audiowalk -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Audiowalk">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A guided walk with an audio commentary that leads participants through a physical space.</rdfs:comment>
        <rdfs:label xml:lang="de">Audiowalk</rdfs:label>
        <rdfs:label xml:lang="en">Audiowalk</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://de.wikipedia.org/wiki/Audiowalk"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Ballet -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Ballet">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A theatrical dance in which a formal academic dance technique—the danse d’école—is combined with other artistic elements such as music, costume, and stage scenery.</rdfs:comment>
        <rdfs:label xml:lang="en">Ballet</rdfs:label>
        <rdfs:label xml:lang="de">Ballett</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Ballet"/>
        <rdfs:seeAlso rdf:resource="https://www.britannica.com/art/ballet"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4004351-4"/>
        <skos:exactMatch rdf:resource="http://www.kanzaki.com/ns/music#Ballet"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Cabaret -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Cabaret">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A form of cabaret known for its political satire and humorous content, particularly popular in German-speaking countries.</rdfs:comment>
        <rdfs:label xml:lang="en">Cabaret</rdfs:label>
        <rdfs:label xml:lang="de">Kabarett</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Cabaret"/>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4029104-2"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#CabaretComedy -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#CabaretComedy">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre that blends cabaret-style performances with comedic elements.</rdfs:comment>
        <rdfs:label xml:lang="en">Cabaret Comedy</rdfs:label>
        <rdfs:label xml:lang="de">Kabarett-Comedy</rdfs:label>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#ChamberMusicConcert -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#ChamberMusicConcert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre featuring chamber music concert, typically performed by a small group of musicians.</rdfs:comment>
        <rdfs:label xml:lang="en">Chamber Music Concert</rdfs:label>
        <rdfs:label xml:lang="de">Kammerkonzert</rdfs:label>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/7727959-1"/>
        <skos:exactMatch rdf:resource="http://www.kanzaki.com/ns/music#Chamber_Music"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Concert -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Concert">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A live music performance in front of an audience.</rdfs:comment>
        <rdfs:label xml:lang="en">Concert</rdfs:label>
        <rdfs:label xml:lang="de">Konzert</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Concert"/>
        <skos:exactMatch rdf:resource="http://www.kanzaki.com/ns/music#Concert"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#ContemporaryDance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#ContemporaryDance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of dance that draws on various styles and techniques to create modern movement vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Contemporary Dance</rdfs:label>
        <rdfs:label xml:lang="de">Zeitgenössischer Tanz</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Contemporary_dance"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Dance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Dance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre that uses movement to express ideas or tell a story.</rdfs:comment>
        <rdfs:label xml:lang="en">Dance</rdfs:label>
        <rdfs:label xml:lang="de">Tanztheater</rdfs:label>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4184451-8"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#DigitalTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#DigitalTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of theater that incorporates digital technology in its production or presentation.</rdfs:comment>
        <rdfs:label xml:lang="en">Digital Theater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Digital_theatre"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#GameTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#GameTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A genre of theater that integrates elements of game design, often involving audience participation.</rdfs:comment>
        <rdfs:label xml:lang="en">Game Theater</rdfs:label>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#ImprovisationalTheater -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#ImprovisationalTheater">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A form of theater where most or all of what is performed is created spontaneously without a script.</rdfs:comment>
        <rdfs:label xml:lang="de">Improtheater</rdfs:label>
        <rdfs:label xml:lang="en">Improvisational Theater</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Improvisational_theatre"/>
        <skos:altLabel xml:lang="de">Improvisationstheater</skos:altLabel>
        <skos:altLabel xml:lang="de">Stegreiftheater</skos:altLabel>
        <skos:exactMatch rdf:resource="http://d-nb.info/gnd/4183004-0"/>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#Installation -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#Installation">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">An art form that uses three-dimensional works designed to transform the perception of a space.</rdfs:comment>
        <rdfs:label xml:lang="en">Installation</rdfs:label>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#LecturePerformance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#LecturePerformance">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A hybrid genre that combines the delivery of a lecture with performance art.</rdfs:comment>
        <rdfs:label xml:lang="de">Lecture Performance</rdfs:label>
        <rdfs:label xml:lang="en">Lecture Performance</rdfs:label>
        <skos:inScheme rdf:resource="http://w3id.org/drk/vocabs/theatrical-genres#"/>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/drk/vocabs/theatrical-genres#LiveRadioPlay -->


    <owl:NamedIndividual rdf:about="http://w3id.org/drk/vocabs/theatrical-genres#LiveRadioPlay">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">A dramatized, purely acoustic performance, performed in front of a live audience.</rdfs:comment>
        <rdfs:label xml:lang="en">Live Radio Play</rdfs:label>
        <rdfs:label xml:lang="de">Live-Hörspiel</rdfs:label>
