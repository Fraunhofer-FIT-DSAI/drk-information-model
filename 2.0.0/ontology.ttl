@prefix : <https://w3id.org/drk/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/drk/ontology/> .

<https://w3id.org/drk/ontology/> rdf:type owl:Ontology ;
                                  owl:versionIRI <https://w3id.org/drk/ontology/2.0.0> ;
                                  owl:imports <https://w3id.org/drk/vocabs/languages-iso639-1> ;
                                  <http://creativecommons.org/ns#license> <http://creativecommons.org/licenses/by/4.0/> ;
                                  <http://purl.org/dc/terms/audience> "Cultural institutions"@en ,
                                                                      "Researchers"@en ,
                                                                      "Theater professionals"@en ;
                                  <http://purl.org/dc/terms/coverage> "Global"@en ;
                                  <http://purl.org/dc/terms/created> "2024-10-22"^^xsd:date ;
                                  <http://purl.org/dc/terms/description> """
        The Culture Ontology (aka DRK (Datenraum Kultur) ontology) provides a comprehensive vocabulary for describing theatrical productions and cultural events.
        It includes concepts for:
        - Theatrical productions and events
        - Characters, roles and performances
        - Venues and their accessibility
        - Event scheduling and management

        The ontology is designed to be extensible and interoperable with other cultural heritage vocabularies.
    """@en ;
                                  <http://purl.org/dc/terms/hasVersion> "2.0.0" ;
                                  <http://purl.org/dc/terms/issued> "2026-06-16"^^xsd:date ;
                                  <http://purl.org/dc/terms/language> <https://w3id.org/drk/vocabs/languages-iso639-1#de> ,
                                                                      <https://w3id.org/drk/vocabs/languages-iso639-1#en> ;
                                  <http://purl.org/dc/terms/license> <http://creativecommons.org/licenses/by/4.0/> ;
                                  <http://purl.org/dc/terms/modified> "2026-06-16"^^xsd:date ;
                                  <http://purl.org/dc/terms/publisher> _:genid1 ;
                                  <http://purl.org/dc/terms/rights> "This ontology is distributed under Creative Commons Attribution 4.0 International License"@en ;
                                  <http://purl.org/dc/terms/subject> "Cultural Events"@en ,
                                                                     "Performing Arts"@en ,
                                                                     "Play Production"@en ,
                                                                     "Theater"@en ,
                                                                     "Theatrical Production"@en ;
                                  <http://purl.org/dc/terms/title> "Culture Ontology"@en ,
                                                                   "Kultur Ontologie"@de ;
                                  <http://purl.org/ontology/bibo/doi> "10.5281/zenodo.15294907" ;
                                  <http://purl.org/vocab/vann/example> <https://github.com/Fraunhofer-FIT-DSAI/drk-information-model/tree/main/examples> ;
                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "drk" ;
                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/drk/ontology/" ;
                                  rdfs:comment "The Culture Ontology (aka Culture Dataspace (DRK) Ontology) is designed in the Datenraum Kultur (DRK) project for the Culture Dataspace, providing extensible semantic concepts, properties, and their interrelationships for modeling metadata related to theaters, theatrical productions, and their showtimes."@en ;
                                  rdfs:label "Culture Ontology"@en ,
                                             "Kultur Ontologie"@de ;
                                  rdfs:seeAlso <https://github.com/Fraunhofer-FIT-DSAI/drk-information-model> ;
                                  owl:priorVersion <https://w3id.org/drk/ontology/1.0.1> ;
                                  owl:versionInfo "2.0.0" ;
                                  <https://schema.org/author> "Christoph Lange-Bever" ,
                                                              "Daham Mohammed Mustafa" ,
                                                              "Peter Retzlaff" ,
                                                              "Rohit A. Deshmukh" .

_:genid1 rdf:type <http://xmlns.com/foaf/0.1/Organization> ;
          <http://xmlns.com/foaf/0.1/homepage> <https://www.fit.fraunhofer.de/> ;
          <http://xmlns.com/foaf/0.1/name> "Fraunhofer FIT" .

