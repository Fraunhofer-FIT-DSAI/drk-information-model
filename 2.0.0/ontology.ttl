                                              <http://purl.org/dc/terms/title> "Character Types Vocabulary"@en ;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "tchar" ;
                                              <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/drk/vocabs/character-types#" ;
                                              rdfs:comment "A controlled vocabulary for listing and describing various types of characters in creative works such as plays or movies."@en ;
                                              rdfs:label "Character Types Vocabulary"@en .


###  http://w3id.org/drk/vocabs/character-types#Animal
<http://w3id.org/drk/vocabs/character-types#Animal> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "A non-human animal character in a creative work such as a play. For example, 'Simba' from The Lion King."@en ;
                                                    rdfs:label "Animal Character"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Animal> ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://dbpedia.org/ontology/Animal> ,
                                                                                                     <https://www.wikidata.org/entity/Q729> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> .


###  http://w3id.org/drk/vocabs/character-types#ImaginaryEntity
<http://w3id.org/drk/vocabs/character-types#ImaginaryEntity> rdf:type owl:NamedIndividual ,
                                                                      <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                             rdfs:comment "A fictional or mythical being, legendary creature, or a fantasy entity character in a creative work such as a play. For example, the fairy 'Puck' from A Midsummer Night's Dream."@en ;
                                                             rdfs:label "Imaginary Entity Character"@en ;
                                                             rdfs:seeAlso <https://en.wikipedia.org/wiki/Fairy> ,
                                                                          <https://en.wikipedia.org/wiki/Legendary_creature> ;
                                                             <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> ;
                                                             <http://www.w3.org/2004/02/skos/core#narrowMatch> <https://www.wikidata.org/entity/Q8028> .


###  http://w3id.org/drk/vocabs/character-types#InanimateObject
<http://w3id.org/drk/vocabs/character-types#InanimateObject> rdf:type owl:NamedIndividual ,
                                                                      <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                             rdfs:comment "A physical non-living thing character in a creative work such as a play. For example, the flying 'Magic Carpet' from Aladdin."@en ;
                                                             rdfs:label "Inanimate Object Character"@en ;
                                                             rdfs:seeAlso <https://en.wikipedia.org/wiki/Physical_object> ;
                                                             <http://www.w3.org/2004/02/skos/core#closeMatch> <https://www.wikidata.org/entity/Q61964280> ;
                                                             <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> .


###  http://w3id.org/drk/vocabs/character-types#Person
<http://w3id.org/drk/vocabs/character-types#Person> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "A real or fictional human individual who is a character in a creative work such as a play. For example, 'Romeo' from Romeo and Juliet by William Shakespeare."@en ;
                                                    rdfs:label "Person Character"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Person> ;
                                                    <http://www.w3.org/2004/02/skos/core#altLabel> "Human Character"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://xmlns.com/foaf/0.1/Person> ,
                                                                                                     <https://schema.org/Person> ,
                                                                                                     <https://www.wikidata.org/entity/Q5> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> .


###  http://w3id.org/drk/vocabs/character-types#Puppet
<http://w3id.org/drk/vocabs/character-types#Puppet> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "A figure or model character in a creative work such as a play that is meant to be manipulated by a puppeteer in performances. For example, 'Kermit the Frog' from The Muppet Show."@en ;
                                                    rdfs:label "Puppet Character"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Puppet> ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://www.wikidata.org/entity/Q1913135> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> .


###  http://w3id.org/drk/vocabs/character-types#Robot
<http://w3id.org/drk/vocabs/character-types#Robot> rdf:type owl:NamedIndividual ,
                                                            <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                   rdfs:comment "A machine character that is meant to perform physical activities in a creative work such as a play. For example, the 'WALL-E' robot from Pixar's WALL-E movie."@en ;
                                                   rdfs:label "Robot Character"@en ;
                                                   rdfs:seeAlso <https://en.wikipedia.org/wiki/Robot> ;
                                                   <http://www.w3.org/2004/02/skos/core#closeMatch> <https://www.wikidata.org/entity/Q11012> ;
                                                   <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/character-types#> .


###  http://w3id.org/drk/vocabs/performer-types#
<http://w3id.org/drk/vocabs/performer-types#> rdf:type owl:NamedIndividual ,
                                                       <http://purl.org/vocommons/voaf#Vocabulary> ,
                                                       <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                              <http://purl.org/dc/terms/description> "A controlled vocabulary for listing and describing various types of performers in a creative work such as a play or a movie."@en ;
                                              <http://purl.org/dc/terms/hasVersion> "0.0.1" ;
                                              <http://purl.org/dc/terms/title> "Performer Types Vocabulary"@en ;
                                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "tperf"@en ;
                                              <http://purl.org/vocab/vann/preferredNamespaceUri> "http://w3id.org/drk/vocabs/performer-types#" ;
                                              rdfs:comment "A controlled vocabulary for listing and describing various types of performers in a creative work such as a play or a movie."@en ;
                                              rdfs:label "Performer Types Vocabulary"@en .


###  http://w3id.org/drk/vocabs/performer-types#Animal
<http://w3id.org/drk/vocabs/performer-types#Animal> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "A non-human animal that performs a role in the production or performance of a creative work such as a play or a movie. For example, 'Crystal the Monkey' played the role of 'Dexter' in the 2006 movie 'Night at the Museum'."@en ;
                                                    rdfs:label "Animal Performer"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Animal> ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://dbpedia.org/ontology/Animal> ,
                                                                                                     <https://www.wikidata.org/entity/Q729> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#CGI
<http://w3id.org/drk/vocabs/performer-types#CGI> rdf:type owl:NamedIndividual ,
                                                          <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                 rdfs:comment "CGI used to perform a character role in a creative work such as a play or a movie. Examples include 'The T-rex' from the 1993 movie 'Jurassic Park', 'Gollum' from 'The Lord of the Rings Trilogy', and 'WALL-E' from Pixar's 2008 movie 'WALL-E'."@en ;
                                                 rdfs:label "Computer-Generated Imagery (CGI) Performer"@en ;
                                                 rdfs:seeAlso <https://en.wikipedia.org/wiki/Computer-generated_imagery> ;
                                                 <http://www.w3.org/2004/02/skos/core#exactMatch> <https://www.wikidata.org/entity/Q6002306> ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#InanimateObject
<http://w3id.org/drk/vocabs/performer-types#InanimateObject> rdf:type owl:NamedIndividual ,
                                                                      <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                             rdfs:comment "A physical non-living thing that performs a role in a creative work such as a play or a movie. Examples include Captain America's Shield from Marvel Cinematic Universe, 'Wilson the Volleyball' from the 2000 movie 'Cast Away'."@en ;
                                                             rdfs:label "Inanimate Object Performer"@en ;
                                                             rdfs:seeAlso <https://en.wikipedia.org/wiki/Physical_object> ;
                                                             <http://www.w3.org/2004/02/skos/core#closeMatch> <https://www.wikidata.org/entity/Q61964280> ;
                                                             <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#Organization
<http://w3id.org/drk/vocabs/performer-types#Organization> rdf:type owl:NamedIndividual ,
                                                                   <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                          rdfs:comment "A company or organization performing a role in the production of a creative work, e.g., by funding or sponsoring it."@en ;
                                                          rdfs:label "Organization Performer"@en ;
                                                          rdfs:seeAlso <https://en.wikipedia.org/wiki/Organization> ;
                                                          <http://www.w3.org/2004/02/skos/core#closeMatch> <https://dbpedia.org/ontology/Organization> ,
                                                                                                           <https://schema.org/Organization> ,
                                                                                                           <https://www.wikidata.org/entity/Q43229> ;
                                                          <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#Person
<http://w3id.org/drk/vocabs/performer-types#Person> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "A human individual that performs a role in the production or performance of a creative work such as a play or a movie. For example, William Shakespeare performed the role of author in the production of his play 'Romeo and Juliet'; Christian Bale performed the roles of 'Actor' and 'Protagonist' while playing the characters of 'Batman' and 'Bruce Wayne' in Christopher Nolan's 2008 movie 'The Dark Knight'."@en ;
                                                    rdfs:label "Person Performer"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Person> ;
                                                    <http://www.w3.org/2004/02/skos/core#altLabel> "Human Performer"@en ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <http://xmlns.com/foaf/0.1/Person> ,
                                                                                                     <https://dbpedia.org/ontology/Person> ,
                                                                                                     <https://schema.org/Person> ,
                                                                                                     <https://www.wikidata.org/entity/Q5> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#Puppet
<http://w3id.org/drk/vocabs/performer-types#Puppet> rdf:type owl:NamedIndividual ,
                                                             <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                    rdfs:comment "An inanimate figure or model manipulated by a puppeteer that performs a role in a creative work such as a play or a movie. For example, the kermit puppet artifact that featured as 'Kermit the Frog' in 'The Muppet Show'. Jim Henson's original Kermit is currently on display at the National Museum of American History."@en ;
                                                    rdfs:label "Puppet Performer"@en ;
                                                    rdfs:seeAlso <https://en.wikipedia.org/wiki/Puppet> ;
                                                    <http://www.w3.org/2004/02/skos/core#closeMatch> <https://www.wikidata.org/entity/Q1913135> ;
                                                    <http://www.w3.org/2004/02/skos/core#inScheme> <http://w3id.org/drk/vocabs/performer-types#> .


###  http://w3id.org/drk/vocabs/performer-types#Puppeteer
<http://w3id.org/drk/vocabs/performer-types#Puppeteer> rdf:type owl:NamedIndividual ,
                                                                <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                       rdfs:comment "A person who manipulates a puppet in the performance of a creative work such as a play or a movie. For example, Jim Henson as the puppeteer for 'Kermit the Frog' in 'The Muppet Movie' (1979)."@en ;
