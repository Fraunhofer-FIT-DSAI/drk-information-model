#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://schema.org/genre
<https://schema.org/genre> rdf:type owl:ObjectProperty .


###  https://w3id.org/drk/ontology/accessibilityDescription
:accessibilityDescription rdf:type owl:ObjectProperty ;
                          rdfs:domain :PlaceAccessibilityFeature ;
                          rdfs:range <https://schema.org/Text> .


###  https://w3id.org/drk/ontology/accessibleWith
:accessibleWith rdf:type owl:ObjectProperty ;
                rdfs:domain :PlaceAccessibilityFeature ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                rdfs:comment "A property that is used to specify with what disability profile can a person access the given place. For example, the place owner or an external agency might specify that the given place can be comfortably accessed by a person who uses a wheelchair, or who has a visual impairment."@en ;
                rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                rdfs:label "Accessible With Personal (Disability) Profile Property"@en .


###  https://w3id.org/drk/ontology/animalPolicy
:animalPolicy rdf:type owl:ObjectProperty ;
              rdfs:domain :PlaceAccessibilityFeature ;
              rdfs:range :AnimalPolicy ;
              <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
              rdfs:comment "A property that is used to describe the policies of a place concerning bringing animals along."@en ;
              rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
              rdfs:label "Animal Policy Property"@en .


###  https://w3id.org/drk/ontology/associatedDataService
:associatedDataService rdf:type owl:ObjectProperty ;
                       rdfs:domain :Organization ;
                       rdfs:range <http://www.w3.org/ns/dcat#DataService> ;
                       rdfs:comment "A property that links an organization to an associated data service through which its data can be accessed or provided."@en ;
                       rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                       rdfs:label "Associated Data Service"@en .


###  https://w3id.org/drk/ontology/character
:character rdf:type owl:ObjectProperty ;
           rdfs:domain :CharacterPerformanceRole ;
           rdfs:range :Character ;
           rdfs:comment "A property that links a character performance role to the character represented or performed in that role."@en ;
           rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
           rdfs:label "Character"@en .


###  https://w3id.org/drk/ontology/characterPerformanceRole
:characterPerformanceRole rdf:type owl:ObjectProperty ;
                          rdfs:domain :TheatricalEvent ;
                          rdfs:range :CharacterPerformanceRole ;
                          rdfs:comment "A property that is used to specify and link the details of characters in a creative work such as a play to the respective performers and the roles played by them."@en ;
                          rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                          rdfs:label "Character Performance Role Property"@en .


###  https://w3id.org/drk/ontology/characterRole
:characterRole rdf:type owl:ObjectProperty ;
               rdfs:domain :TheatricalProduction ;
               rdfs:range :CharacterPerformanceRole ;
               rdfs:comment "A property that is used to specify the characters and the roles played by them in a theatrical play. For example, the role of 'Romeo' in 'Romeo and Juliet' by William Shakespeare is a character role."@en ;
               rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
               rdfs:label "Character Role"@en .


###  https://w3id.org/drk/ontology/characterType
:characterType rdf:type owl:ObjectProperty ;
               rdfs:domain :Character ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "A property that specifies the type of a character in a creative work or during an event. Examples of character types include person, animal, organization, puppet, robot, inanimate object, imaginary entity, etc."@en ;
               rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
               rdfs:label "Character Type"@en .


###  https://w3id.org/drk/ontology/containsTheaterShowtimesRecord
:containsTheaterShowtimesRecord rdf:type owl:ObjectProperty ;
                                rdfs:domain :TheaterShowtimesDataset ;
                                rdfs:range rdfs:Resource ;
                                rdfs:comment "A property that links a theater showtimes dataset to a theater showtimes record, for example a named graph or other RDF resource representing a record in the dataset."@en ;
                                rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                                rdfs:label "Contains Theater Showtimes Record"@en .


###  https://w3id.org/drk/ontology/creatorRole
:creatorRole rdf:type owl:ObjectProperty ;
             rdfs:domain :TheatricalProduction ;
             rdfs:range :ProductionRole ;
             rdfs:comment "A property that is used to specify the names of creator roles involved in a theatrical production that are, for instance, not characters in the play. For example, William Shakespeare performed the roles of playwright and creator in the production of his play 'Romeo and Juliet'."@en ;
             rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
             rdfs:label "Creator Role"@en .


###  https://w3id.org/drk/ontology/eventRole
:eventRole rdf:type owl:ObjectProperty ;
           rdfs:domain :Event ;
           rdfs:range :ProductionRole ;
           rdfs:comment "A property that is used to link the production roles in an event that features theatrical work such as a play to its performers. Event roles are (mostly off-stage) production roles that are performed during the preparation or performance of an Event. Examples include director, costume designer, stage manager, set/stage designer, lighting designer, sound designer, sound engineer, technical director, makeup artist, choreographer, understudy, usher, production manager, producer, funder, sponsor, front of house manager, etc."@en ;
           rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
           rdfs:label "Event Role Property"@en .


###  https://w3id.org/drk/ontology/eventType
:eventType rdf:type owl:ObjectProperty ;
           rdfs:domain :Event ;
           rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "A property that specifies theatrical event types such as Premiere, Last Performance, Guest Performance, etc."@en ;
           rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
           rdfs:label "Event Type"@en .


###  https://w3id.org/drk/ontology/hasAccessibilityFeature
:hasAccessibilityFeature rdf:type owl:ObjectProperty ;
                         rdfs:domain :Place ;
                         rdfs:range :PlaceAccessibilityFeature ;
                         rdfs:comment "A property that is used to describe the physical (and sometimes human-rated) accessibility of a physical place."@en ;
                         rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                         rdfs:label "Has Accessibility Feature Property"@en .


###  https://w3id.org/drk/ontology/hasTheatricalEvent
:hasTheatricalEvent rdf:type owl:ObjectProperty ;
                    rdfs:domain :TheaterOrganization ;
                    rdfs:range :TheatricalEvent ;
                    rdfs:comment "A property that links a theater organization to a theatrical event associated with that organization."@en ;
                    rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                    rdfs:label "Has Theatrical Event"@en .


###  https://w3id.org/drk/ontology/hasTheatricalProduction
:hasTheatricalProduction rdf:type owl:ObjectProperty ;
                         rdfs:domain :TheaterOrganization ;
                         rdfs:range :TheatricalProduction ;
                         rdfs:comment "A property that links a theater organization to a theatrical production associated with that organization."@en ;
                         rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                         rdfs:label "Has Theatrical Production"@en .


###  https://w3id.org/drk/ontology/navigationMapURL
:navigationMapURL rdf:type owl:ObjectProperty ;
                  rdfs:domain :Place ;
                  rdfs:range <https://schema.org/URL> .


###  https://w3id.org/drk/ontology/performer
:performer rdf:type owl:ObjectProperty ;
           rdfs:domain :Role ;
           rdfs:range :Performer ;
           rdfs:comment "A property that is used to specify the performer of a role in a creative work or event."@en ;
           rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
           rdfs:label "Performer"@en .


###  https://w3id.org/drk/ontology/performerType
:performerType rdf:type owl:ObjectProperty ;
               rdfs:domain :Performer ;
               rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
               rdfs:comment "A property that specifies the type of performer that performs a role in a creative work or event. Examples of performer types include persons, animals, organizations, puppets, robots, inanimate objects, or even computer-generated imagery (CGI)."@en ;
               rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
               rdfs:label "Performer Type"@en .


###  https://w3id.org/drk/ontology/productionType
:productionType rdf:type owl:ObjectProperty ;
                rdfs:domain :TheatricalProduction ;
                rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                rdfs:comment "A property that specifies the production type of a creative work, such as 'World Premiere', 'Language Premiere', etc."@en ;
                rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                rdfs:label "Production Type"@en .


###  https://w3id.org/drk/ontology/subtitleLanguage
:subtitleLanguage rdf:type owl:ObjectProperty ;
                  rdfs:domain :TheatricalEvent ;
                  rdfs:range <https://schema.org/Language> ;
                  rdfs:comment "A property that specifies the languages in which subtitles or captions are available during a Theatrical Event."@en ;
                  rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                  rdfs:label "Subtitle Language"@en .


###  https://w3id.org/drk/ontology/theatricalGenre
:theatricalGenre rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <https://schema.org/genre> ;
                 rdfs:domain :TheatricalProduction ;
                 rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "A property that specifies the theatrical genre of a theatrical production."@en ;
                 rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                 rdfs:label "Theatrical Genre"@en .


###  https://w3id.org/drk/ontology/wheelchairPlaces
:wheelchairPlaces rdf:type owl:ObjectProperty ;
                  rdfs:domain :PlaceAccessibilityFeature ;
                  rdfs:range :WheelchairPlaces ;
                  <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                  rdfs:comment "A property that is used to describe the presence of reserved spots for wheelchairs at a place."@en ;
                  rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                  rdfs:label "Wheelchair Places Property"@en .


#################################################################
#    Data properties
#################################################################

###  https://schema.org/URL
<https://schema.org/URL> rdf:type owl:DatatypeProperty .


###  https://w3id.org/drk/ontology/accessibilityDescription
:accessibilityDescription rdf:type owl:DatatypeProperty .


###  https://w3id.org/drk/ontology/allowsAssistanceDogs
:allowsAssistanceDogs rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf :allowsDogs ,
                                         :allowsServiceAnimals ;
                      rdfs:domain :AnimalPolicy ;
                      rdfs:range xsd:boolean ;
                      <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                      rdfs:comment "A property that describes if the place allows visitors to bring assistance/service dogs. Assistance dogs, also referred to as a service dogs, are a specific type of service animals that receive specialized training to aid an individual with a disability in navigating everyday life (source: https://en.wikipedia.org/wiki/Assistance_dog)."@en ;
                      rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                      rdfs:label "Allows Assistance/Service Dogs"@en .


###  https://w3id.org/drk/ontology/allowsDogs
:allowsDogs rdf:type owl:DatatypeProperty ;
            rdfs:domain :AnimalPolicy ;
            rdfs:range xsd:boolean ;
            <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
            rdfs:comment "A property that describes if the place allows visitors to bring dogs in general."@en ;
            rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
            rdfs:label "Allows Dogs"@en .


###  https://w3id.org/drk/ontology/allowsGuideDogs
:allowsGuideDogs rdf:type owl:DatatypeProperty ;
                 rdfs:subPropertyOf :allowsAssistanceDogs ;
                 rdfs:domain :AnimalPolicy ;
                 rdfs:range xsd:boolean ;
                 <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                 rdfs:comment "A property that describes if the place allows visitors to bring guide dogs. Guide dogs are a specialized type of assistance dogs, trained to lead individuals who are blind or visually impaired around obstacles (source: https://en.wikipedia.org/wiki/Guide_dog)."@en ;
                 rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                 rdfs:label "Allows Guide Dogs"@en .


###  https://w3id.org/drk/ontology/allowsServiceAnimals
:allowsServiceAnimals rdf:type owl:DatatypeProperty ;
                      rdfs:domain :AnimalPolicy ;
                      rdfs:range xsd:boolean ;
                      <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                      rdfs:comment "A property that describes if the place allows visitors to bring service animals along. A Service Animal is an animal that has been trained to assist a disabled person (source: https://en.wikipedia.org/wiki/Service_animal). While dogs are the most common service animals, other animals (like miniature horses, ferrets, parrots, and monkeys) may also serve in this role, depending upon regional regulations."@en ;
                      rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                      rdfs:label "Allows Service Animals"@en .


###  https://w3id.org/drk/ontology/hasSpaceForAssistant
:hasSpaceForAssistant rdf:type owl:DatatypeProperty ;
                      rdfs:domain :WheelchairPlaces ;
                      rdfs:range xsd:boolean ;
                      <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                      rdfs:comment "A property that specifies whether the place has additional space for a wheelchair assistant."@en ;
                      rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                      rdfs:label "Has Space For Wheelchair Assistant Property"@en .


###  https://w3id.org/drk/ontology/intermissionCount
:intermissionCount rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Event ;
                   rdfs:range xsd:nonNegativeInteger ;
                   rdfs:comment "A property that specifies the number of intermissions or breaks during an Event."@en ;
                   rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                   rdfs:label "Intermission Count"@en .


###  https://w3id.org/drk/ontology/navigationMapURL
:navigationMapURL rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf <https://schema.org/URL> .


###  https://w3id.org/drk/ontology/wheelchairPlacesCount
:wheelchairPlacesCount rdf:type owl:DatatypeProperty ;
                       rdfs:domain :WheelchairPlaces ;
                       rdfs:range xsd:nonNegativeInteger ;
                       <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                       rdfs:comment "A property that specifies the number of designated places for wheelchairs, for example, in a theater place or a cinema hall."@en ;
                       rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                       rdfs:label "Wheelchair Places Count Property"@en .


###  https://w3id.org/drk/ontology/wheelchairUserCapacity
:wheelchairUserCapacity rdf:type owl:DatatypeProperty ;
                        rdfs:domain :WheelchairPlaces ;
                        rdfs:range xsd:nonNegativeInteger ;
                        <http://purl.org/dc/terms/source> <https://sozialhelden.github.io/a11yjson/describing-objects/0-model/> ;
                        rdfs:comment "A property that specifies the number of people using a wheelchair that can be accommodated at the same time. This property should be used when there is no designated space for wheelchair users, but the number is known."@en ;
                        rdfs:isDefinedBy <https://w3id.org/drk/ontology/> ;
                        rdfs:label "Wheelchair User Capacity Property"@en .


#################################################################
#    Classes
#################################################################

###  http://purl.org/vocommons/voaf#Vocabulary
<http://purl.org/vocommons/voaf#Vocabulary> rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Resource
rdfs:Resource rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#DataService
