tsgap:PlaceShape a sh:NodeShape ;
    sh:targetClass drk:Place ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:address ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class schema:PostalAddress
    ] ;
    sh:property [
        sh:path drk:hasAccessibilityFeature ;
        sh:maxCount 1 ;
        sh:class drk:PlaceAccessibilityFeature
    ] ;
    sh:property [
        sh:path schema:latitude ;
        sh:maxCount 1 ;
        sh:or (
            [
              sh:or (
                  [ sh:datatype xsd:decimal ]
                  [ sh:datatype xsd:double ]
                  [ sh:datatype xsd:integer ]
              )
            ]
            [
              sh:datatype xsd:string
            ]
        )
    ] ;
    sh:property [
        sh:path schema:longitude ;
        sh:maxCount 1 ;
        sh:or (
            [
              sh:or (
                  [ sh:datatype xsd:decimal ]
                  [ sh:datatype xsd:double ]
                  [ sh:datatype xsd:integer ]
              )
            ]
            [
              sh:datatype xsd:string
            ]
        )
    ] ;
    sh:property [
        sh:path drk:navigationMapURL ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:hasMap ;
        sh:class schema:Map
    ] .

tsgap:OfferShape a sh:NodeShape ;
    sh:targetClass schema:Offer ;
