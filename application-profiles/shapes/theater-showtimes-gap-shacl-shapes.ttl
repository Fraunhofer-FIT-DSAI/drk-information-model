tsgap:TheaterShowtimesDatasetShape a sh:NodeShape ;
    sh:targetClass drk:TheaterShowtimesDataset ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:minCount 1 ;
        sh:class dcat:Distribution
    ] ;
    sh:property [
        sh:path dcat:version ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:minCount 1 ;
        sh:class vcard:Kind
    ] ;
    sh:property [
        sh:path dcat:keyword ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:minCount 1 ;
        sh:class foaf:Agent
    ] ;
    sh:property [
        sh:path dcterms:publisher ;
        sh:minCount 1 ;
        sh:class foaf:Agent
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        )
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        )
    ] ;
    sh:property [
        sh:path dcterms:license ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class dcterms:LicenseDocument
    ] ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:minCount 1 ;
        sh:class dcterms:RightsStatement
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:class dcterms:Standard
    ] ;
    sh:property [
        sh:path dcat:theme ;
        sh:class skos:Concept
    ] ;
    sh:property [
        sh:path dcterms:type ;
        sh:datatype xsd:anyURI
    ] ;
    sh:property [
        sh:path dcterms:language ;
        sh:node tsgap:EULanguageValueShape
    ] ;
    sh:property [
        sh:path odrl:hasPolicy ;
        sh:class odrl:Policy
    ] ;
    sh:property [
        sh:path dcterms:accrualPeriodicity ;
        sh:maxCount 1 ;
        sh:class dcterms:Frequency ;
        sh:message "Use a value from the Dublin Core Collection Description Frequency Vocabulary."
    ] ;
    sh:property [
        sh:path schema:collectionSize ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path dcterms:spatial ;
        sh:class dcterms:Location
    ] ;
    sh:property [
        sh:path dcterms:temporal ;
        sh:class dcterms:PeriodOfTime
    ] ;
    sh:property [
        sh:path drk:containsTheaterShowtimesRecord ;
        sh:nodeKind sh:BlankNodeOrIRI
    ] .

tsgap:DistributionShape a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:modified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        )
    ] ;
    sh:property [
        sh:path dcterms:issued ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        )
    ] ;
    sh:property [
        sh:path dcat:accessService ;
        sh:class dcat:DataService
    ] ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:downloadURL ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:mediaType ;
        sh:maxCount 1 ;
        sh:class dcterms:MediaType
    ] ;
    sh:property [
        sh:path spdx:checksum ;
        sh:class spdx:Checksum
    ] ;
    sh:or (
        [
            sh:property [
                sh:path dcat:accessService ;
                sh:minCount 1
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path dcat:downloadURL ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path dcat:mediaType ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) ;
    sh:message "Must contain either (dcat:accessService OR (dcat:downloadURL AND dcat:mediaType))."  .

tsgap:DataServiceShape a sh:NodeShape ;
    sh:targetClass drk:DataService ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcterms:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:servesDataset ;
        sh:minCount 1 ;
        sh:class dcat:Dataset
    ] ;
    sh:property [
        sh:path dcat:endpointURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal
    ] ;
    sh:property [
        sh:path dcat:endpointDescription ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:minCount 1 ;
        sh:class vcard:Kind
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:class dcterms:Standard
    ] ;
    sh:property [
        sh:path schema:offers ;
        sh:class schema:Offer
    ] .

tsgap:CulturalOrganizationShape a sh:NodeShape ;
    sh:targetClass drk:CulturalOrganization .

tsgap:MapShape a sh:NodeShape ;
    sh:targetClass schema:Map ;
    sh:property [
        sh:path schema:url ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:mapType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node tsgap:SchemaMapCategoryTypeValueShape
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string
    ] .

tsgap:MediaObjectShape a sh:NodeShape ;
    sh:targetClass schema:MediaObject ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:contentURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:encodingFormat ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:offers ;
        sh:class schema:Offer
    ] ;
    sh:property [
        sh:path schema:recordedAt ;
        sh:maxCount 1 ;
        sh:class schema:Event
    ] .
