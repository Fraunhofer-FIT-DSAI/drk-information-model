tsgap:PeopleAudienceShape a sh:NodeShape ;
    sh:targetClass schema:PeopleAudience ;
    sh:property [
        sh:path schema:requiredMinAge ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path schema:requiredMaxAge ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer
    ] ;
    sh:property [
        sh:path schema:audienceType ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:suggestedMinAge ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:integer ]
        )
    ] ;
    sh:property [
        sh:path schema:suggestedMaxAge ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:integer ]
        )
    ] .

tsgap:CharacterPerformanceRoleShape a sh:NodeShape ;
