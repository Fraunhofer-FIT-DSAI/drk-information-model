    ] .

tsgap:MemberProgramTierShape a sh:NodeShape ;
    sh:targetClass schema:MemberProgramTier ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
