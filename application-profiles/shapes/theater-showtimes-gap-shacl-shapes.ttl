            ]
        )
    ] ;
    sh:property [
        sh:path drk:performer ;
        sh:class drk:Performer
    ] .

tsgap:CharacterShape a sh:NodeShape ;
    sh:targetClass drk:Character ;
    sh:property [
        sh:path schema:name ;
