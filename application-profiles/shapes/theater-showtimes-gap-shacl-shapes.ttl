tsgap:EventShape a sh:NodeShape ;
    sh:targetClass drk:Event ;
    sh:property [
        sh:path drk:intermissionCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger
    ] ;
    sh:property [
        sh:path drk:eventRole ;
        sh:class drk:ProductionRole
    ] ;
    sh:property [
        sh:path drk:eventType ;
        sh:node tsgap:DRKTheatricalEventTypeValueShape
    ] ;
    sh:property [
        sh:path schema:offers ;
        sh:class schema:Offer
    ] .

tsgap:MemberProgramShape a sh:NodeShape ;
    sh:targetClass schema:MemberProgram ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:hostingOrganization ;
        sh:minCount 1 ;
        sh:class schema:Organization
    ] ;
    sh:property [
        sh:path schema:hasTiers ;
        sh:class schema:MemberProgramTier
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:nodeKind sh:IRI
    ] .

tsgap:PriceSpecificationShape a sh:NodeShape ;
    sh:targetClass schema:PriceSpecification ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path schema:priceCurrency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node tsgap:EUCurrencyValueShape
    ] ;
    sh:property [
        sh:path schema:price ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:integer ]
        )
    ] ;
    sh:property [
        sh:path schema:minPrice ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:integer ]
        )
    ] ;
    sh:property [
        sh:path schema:maxPrice ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:integer ]
        )
    ] ;
    sh:or (
        [
            sh:property [
                sh:path schema:price ;
                sh:minCount 1
            ]
        ]
        [
            sh:and (
                [
                    sh:property [
                        sh:path schema:minPrice ;
                        sh:minCount 1
                    ]
                ]
                [
                    sh:property [
                        sh:path schema:maxPrice ;
                        sh:minCount 1
                    ]
                ]
            )
        ]
    ) ;
    sh:message "One of (schema:price OR (schema:minPrice AND schema:maxPrice)) must be present."  .

tsgap:PerformerShape a sh:NodeShape ;
    sh:targetClass drk:Performer ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path drk:performerType ;
        sh:node tsgap:DRKPerformerTypeValueShape
    ] ;
    sh:property [
        sh:path schema:sameAs ;
        sh:nodeKind sh:IRI
    ] .

tsgap:RoleShape a sh:NodeShape ;
    sh:targetClass drk:Role ;
    sh:property [
